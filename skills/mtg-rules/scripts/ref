#!/usr/bin/env fish
# ref — read the reference docs (the "maps") one section at a time.
#   ref                          list the docs
#   ref <doc>                    list a doc's sections (## and ###) with sizes
#   ref <doc> <n | heading>      print one section: its number ("5"), or part of
#                                its heading text ("backing out"), case-insensitive
#   ref --cites <rule>           sections that cite a rule — same granularity as
#                                `rule`: 603 = anything in 603, 603.7 = 603.7 and
#                                its lettered subrules, 603.7e = that subrule only.
#                                Built on `cite list` (one line per citation token)
#                                plus prose ranges ("603.7d–h", "602.3–602.3b"),
#                                which `cite list` does not expand in the skill's
#                                bare-number format; those are expanded here.
#   ref --grep <regex>           sections with lines matching a jq regex (case-insensitive)
#
# <doc> is a file name under references/ (without .md); a unique prefix works.
# Each doc states the CR date it was synthesized from. Printed sections lead
# with a banner repeating it: the maps are syntheses, not sources — cite the CR
# rules, not the map. Exits nonzero on an unknown doc, section, or empty search.

source (path resolve (status dirname))/lib.fish; or exit 1
set -g selfdir (path resolve (status dirname))
set -g refs_dir $skill_dir/references

# One heading-aware pass over a doc. Headings inside code fences are ignored.
# Headings of every level are tracked, and a section runs until the next
# heading of the same or a shallower level.
#   mode=index  start<TAB>end<TAB>level<TAB>number<TAB>heading   per heading
#   mode=count  count<TAB>ordinal<TAB>level<TAB>number<TAB>heading   per heading
#               enclosing lines in $hits (comma-joined line numbers; a repeated
#               number counts repeatedly)
# number is the leading "N" of a heading like "5. Triggered abilities", else "-".
set -g ref_awk '
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
BEGIN {
    n = split(hits, a, ",")
    for (i = 1; i <= n; i++) if (a[i] != "") want[a[i]]++
    n = 0; cur = 0
}
/^[ \t]*(```|~~~)/ { fence = !fence }
!fence && /^#+[ \t]+[^ \t]/ {
    lvl = 0
    while (substr($0, lvl + 1, 1) == "#") lvl++
    if (lvl <= 6) {
        h = trim(substr($0, lvl + 1))
        sub(/[ \t]+#+$/, "", h)
        num = "-"
        if (match(h, /^[0-9]+([.][0-9]+)*[.:)]?[ \t]/)) {
            num = substr(h, 1, RLENGTH)
            sub(/[.:)]?[ \t]+$/, "", num)
        }
        n++; start[n] = NR; level[n] = lvl; number[n] = num; head[n] = h; cur = n
    }
}
NR in want { cnt[cur] += want[NR] }
END {
    if (mode == "index") {
        for (i = 1; i <= n; i++) {
            e = NR
            for (j = i + 1; j <= n; j++) if (level[j] <= level[i]) { e = start[j] - 1; break }
            printf "%d\t%d\t%d\t%s\t%s\n", start[i], e, level[i], number[i], head[i]
        }
    } else {
        for (i = 1; i <= n; i++) if (cnt[i] > 0) printf "%d\t%d\t%d\t%s\t%s\n", cnt[i], i, level[i], number[i], head[i]
        if (cnt[0] > 0) printf "%d\t0\t0\t-\t(before first heading)\n", cnt[0]
    }
}
'

function usage
    echo "usage: ref                      list the reference docs
       ref <doc>                list a doc's sections
       ref <doc> <n|heading>    print one section (number, or heading text)
       ref --cites <rule>       sections citing a rule (603 | 603.7 | 603.7e)
       ref --grep <regex>       sections with matching lines (case-insensitive)"
end

# fail <message> — message plus usage on stderr, exit 1
function fail
    printf '%s\n' "$argv" >&2
    usage >&2
    exit 1
end

# Header date of a doc: the first "effective YYYY-MM-DD" in its first lines.
function _doc_date --argument-names f
    head -n 30 $f | grep -m1 -oE 'effective [0-9]{4}-[0-9]{2}-[0-9]{2}' | string replace 'effective ' ''
end

# Doc path from a name: exact file name first, else a unique prefix. Empty if none.
function _find_doc --argument-names name
    set -l base (path basename (string replace -r '\.md$' '' -- $name))
    test -n "$base"; or return 1
    if test -r $refs_dir/$base.md
        echo $refs_dir/$base.md
        return 0
    end
    set -l pre '^'(string escape --style=regex -- $base)
    set -l found
    for f in $refs_dir/*.md
        string match -rq -- $pre (path basename -E $f); and set -a found $f
    end
    test (count $found) -eq 1; and echo $found[1]
end

# one line per doc: name, title, synthesis date; then a doc's ## and ### sections
function _list_docs
    for f in $refs_dir/*.md
        set -l d (_doc_date $f)
        test -n "$d"; or set d "no date"
        printf '%-26s %s  [%s]\n' (path basename -E $f) (head -1 $f | string replace -r '^# ' '') $d
    end
end

function _list_sections --argument-names f
    for row in (awk -v mode=index "$ref_awk" $f)
        set -l p (string split \t -- $row)
        test $p[3] -ge 2 -a $p[3] -le 3; or continue
        printf '%s§%s (%d lines)\n' (string repeat -n (math $p[3] - 1) '  ') $p[5] (math $p[2] - $p[1] + 1)
    end
end

# "[map] <doc> §<heading> (<n> lines)" per section holding lines in <hits>
# (comma-joined line numbers), most first; document order breaks ties.
function _report --argument-names f hits
    test -n "$hits"; or return 0
    set -l doc (path basename -E $f)
    for row in (awk -v mode=count -v hits="$hits" "$ref_awk" $f | sort -s -t \t -k1,1nr)
        set -l p (string split \t -- $row)
        set -l heading $p[5]
        test $p[3] -le 1; and set heading "(header)"
        set -l unit lines
        test $p[1] -eq 1; and set unit line
        echo "[map] $doc §$heading ($p[1] $unit)"
    end
end

# --- dispatch ---
if test (count $argv) -eq 0
    usage
    echo
    _list_docs
    exit 0
end

switch $argv[1]
    case -h --help
        usage
        exit 0

    case --cites
        test (count $argv) -eq 2; or fail "ref: --cites takes one rule number (603 | 603.7 | 603.7e)"
        set -l q $argv[2]
        set -l mre
        if string match -rq '^\d{3}$' -- $q
            set mre '^'$q'([.]|$)'
        else if string match -rq '^\d{3}\.\d+$' -- $q
            set mre '^'(string escape --style=regex -- $q)'[a-z]*$'
        else if string match -rq '^\d{3}\.\d+[a-z]+$' -- $q
            set mre '^'(string escape --style=regex -- $q)'$'
        else
            fail "ref: '$q' does not look like a CR rule number"
        end
        # Citation sites as "<file><TAB><line>" for every reference-doc line
        # citing a rule in $q's family. Two sources:
        #  1. `cite list`: one line per citation token, "<file>:<line>  <raw>  -> <members>".
        #  2. prose ranges ("603.7d–h", "510.1c-d", "726.1–726.5"). In the skill's
        #     bare format `cite list` yields only a range's first endpoint, so each
        #     candidate line is expanded here over cr.json's document-ordered keys
        #     (the CR's skipped letters l and o fall out of that order).
        set -l listing ($selfdir/cite list)
        test $status -eq 0; or die "ref: cite list failed"
        set -l tokens (printf '%s\n' $listing | jq -R -n -r --arg re $mre '
            inputs
            | capture("^(?<file>[^:]+):(?<line>[0-9]+)  (?<raw>.*?)  -> (?<members>.*)$")
            | select(.file | test("^references/[^/]+[.]md$"))
            | select(.members | split(", ") | any(test($re)))
            | [.file, .line] | @tsv')
        set -l ranges (grep -nE '[1-9][0-9]{2}\.[0-9]+[a-z]? *(–|—|-) *([1-9][0-9]{2}\.[0-9]+[a-z]?|[a-z])' $refs_dir/*.md \
            | jq -R -n -r --arg re $mre --arg root $skill_dir --slurpfile cr $rules_dir/cr.json '
            # Rule order by value, not by cr.json key order (which is not document order
            # across multi-digit rule numbers): [section, rule, letters length, letters].
            def sk: capture("^(?<n>[0-9]+)[.](?<m>[0-9]+)(?<l>[a-z]*)$")
                    | [(.n | tonumber), (.m | tonumber), (.l | length), .l];
            ($cr[0] | keys | map(select(test($re)) | sk)) as $qs
            # does the range $a..$b ("603.7d","h" / "603.7d","603.7h" / "726.1","726.5") cover a rule in the family?
            | def covers($a; $b):
                (if ($b | test("^[a-z]$")) then ($a | sub("[a-z]+$"; "")) + $b else $b end) as $e
                | if ($b | test("^[a-z]$")) and ($a | test("[a-z]$") | not) then false
                  else ($a | sk) as $lo | ($e | sk) as $h
                    # a range ending at a bare N.M takes the lettered subrules of that rule along
                    | (if $h[3] == "" then [$h[0], $h[1], 1000, ""] else $h end) as $hi
                    | any($qs[]; . >= $lo and . <= $hi)
                  end;
              inputs
            | capture("^(?<file>[^:]+):(?<line>[0-9]+):(?<text>.*)$")
            | select(any(.text
                         | match("(?<![0-9A-Za-z])([1-9][0-9]{2}[.][0-9]+[a-z]?) *[–—-] *([1-9][0-9]{2}[.][0-9]+[a-z]?|[a-z])(?![0-9A-Za-z])"; "g")
                         | .captures | map(.string);
                         covers(.[0]; .[1])))
            | [(.file | ltrimstr($root + "/")), .line] | @tsv')
        set -l groups (printf '%s\n' $tokens $ranges | jq -R -n -r '
            [ inputs | select(length > 0) | split("\t") | {file: .[0], line: (.[1] | tonumber)} ]
            | unique | group_by(.file)[]
            | "\(.[0].file)\t\([.[].line] | join(","))"')
        test (count $groups) -gt 0; or die "ref: no reference doc cites $q"
        for g in $groups
            set -l p (string split \t -- $g)
            _report $skill_dir/$p[1] $p[2]
        end
        echo "→ read a section: ref <doc> <number or heading text>"
        exit 0

    case --grep
        test (count $argv) -ge 2; or fail "ref: --grep takes a regex"
        set -l pat (string join ' ' -- $argv[2..])
        echo '""' | jq --arg p "$pat" 'test($p; "i")' >/dev/null 2>&1
        or die "ref: invalid regex: $pat"
        set -l found 0
        for f in $refs_dir/*.md
            set -l hits (jq -R -n -r --arg pat "$pat" '
                [inputs | test($pat; "i")] | to_entries | map(select(.value) | .key + 1) | join(",")' $f)
            test -n "$hits"; or continue
            set found 1
            _report $f $hits
        end
        test $found -eq 1; or die "ref: no reference line matches /$pat/"
        echo "→ read a section: ref <doc> <number or heading text>"
        exit 0

    case '-*'
        fail "ref: unknown option $argv[1]"
end

set -l f (_find_doc $argv[1])
if test -z "$f"
    printf "ref: no reference doc '%s'. Docs:\n" $argv[1] >&2
    _list_docs >&2
    usage >&2
    exit 1
end
set -l doc (path basename -E $f)

if test (count $argv) -eq 1
    set -l d (_doc_date $f)
    test -n "$d"; or set d "no synthesis date"
    echo (head -1 $f)
    echo "synthesized from CR $d — a map, not a source; cite the CR rules"
    _list_sections $f
    exit 0
end

# Resolve the section among headings of level 2 and deeper.
set -l want (string join ' ' -- $argv[2..] | string replace -r '^§' '' | string trim)
set -l rows (awk -v mode=index "$ref_awk" $f | awk -F'\t' '$3 >= 2')
set -l hits
if string match -rq '^[0-9]+(\.[0-9]+)*\.?$' -- $want
    set -l n (string replace -r '\.$' '' -- $want)
    for row in $rows
        set -l p (string split \t -- $row)
        test "$p[4]" = "$n"; and set -a hits $row
    end
end
if test (count $hits) -eq 0
    # Heading text, case-insensitive: whole heading, then heading minus its
    # number, then any substring. The first tier with a match decides.
    set -l w (string lower -- $want)
    set -l wre (string escape --style=regex -- $w)
    for tier in 1 2 3
        for row in $rows
            set -l p (string split \t -- $row)
            set -l h (string lower -- $p[5])
            switch $tier
                case 1
                    test "$h" = "$w"; and set -a hits $row
                case 2
                    test (string replace -r '^[0-9]+([.][0-9]+)*[.:)]?\s+' '' -- $h) = "$w"; and set -a hits $row
                case 3
                    string match -rq -- $wre $h; and set -a hits $row
            end
        end
        test (count $hits) -gt 0; and break
    end
end

if test (count $hits) -eq 0
    echo "ref: no section '$want' in $doc. Sections:" >&2
    _list_sections $f >&2
    echo "usage: ref $doc <section number or heading text>" >&2
    exit 1
end

set -l p (string split \t -- $hits[1])
if test (count $hits) -gt 1
    set -l others
    for row in $hits[2..5]
        set -a others "§"(string split \t -- $row)[5]
    end
    echo "ref: note: "(count $hits)" sections match '$want'; showing the first. Others: "(string join ', ' -- $others)(test (count $hits) -gt 5; and echo ', …') >&2
end

set -l d (_doc_date $f)
set -l from "no synthesis date"
test -n "$d"; and set from "synthesized from CR $d"
echo "[map] $doc §$p[5] (lines $p[1]-$p[2]) — $from. A map, not a source: cite the CR rules (scripts/rule), not the map; uncited claims are inferences."
sed -n "$p[1],$p[2]p" $f
