#!/usr/bin/env fish
# health — one-shot self-diagnosis: data resolution, CR effective date,
# reference-doc synthesis-date summary (warning only), data tiers (with the
# scripts each enables), keyword count, unclassified-keyword warning (warning
# only), plugin version, citation check. Exit 0 iff base tier + citations are OK.

source (path resolve (status dirname))/lib.fish; or exit 1
set -l selfdir (path resolve (status dirname))

# data dir + which resolution-chain candidate won
set -l via "repo-relative"
set -l codex_root "$HOME/.codex"
if set -q CODEX_HOME; and test -n "$CODEX_HOME"
    set codex_root (path normalize "$CODEX_HOME")
end
if set -q MTG_RULES_DATA; and test "$data_dir" = "$MTG_RULES_DATA"
    set via '$MTG_RULES_DATA'
else if set -q PLUGIN_DATA; and test "$data_dir" = "$PLUGIN_DATA"
    set via '$PLUGIN_DATA'
else if set -q CLAUDE_PLUGIN_DATA; and test "$data_dir" = "$CLAUDE_PLUGIN_DATA"
    set via '$CLAUDE_PLUGIN_DATA'
else if test "$data_dir" = "$codex_root/plugins/data/mtg-rules/data"
    set via "Codex plugin data dir"
else if test "$data_dir" = "$HOME/.gemini/config/plugins/mtg-rules/data"
    set via "agy plugin data dir"
else if test "$data_dir" = "$HOME/.claude/plugins/data/mtg-rules/data"
    set via "Claude plugin data dir"
end
echo "data: $data_dir (via $via)"

# CR effective date
if test -r $rules_dir/cr.txt
    set -l line3 (sed -n 3p $rules_dir/cr.txt | string trim)
    set -l m (string match -r 'effective as of (.+?)\.?$' -- $line3)
    if set -q m[2]
        echo "CR effective: $m[2]"
    else
        echo "CR: $line3"
    end
else
    set -l nrules (jq 'length' $rules_dir/cr.json)
    echo "CR effective: date unknown (cr.txt absent; cr.json has $nrules rules)"
end

# reference-doc sync: every reference doc states the CR date it was
# synthesized from (header line); one summary line, with the docs that lag the
# live data or carry no date named compactly. Warning only — never fails the
# exit (citations are the hard gate).
set -l live_iso (cr_effective_iso 2>/dev/null)
if test -n "$live_iso"
    set -l doc_total 0
    set -l doc_synced 0
    set -l doc_lag
    for f in $skill_dir/references/*.md
        set doc_total (math $doc_total + 1)
        set -l d (head -n 30 $f | grep -m1 -oE 'effective [0-9]{4}-[0-9]{2}-[0-9]{2}' | string replace 'effective ' '')
        if test -z "$d"
            set -a doc_lag (path basename $f)" (no date)"
        else if test "$d" != "$live_iso"
            set -a doc_lag (path basename $f)" ($d)"
        else
            set doc_synced (math $doc_synced + 1)
        end
    end
    echo "reference docs: $doc_synced/$doc_total synthesized from CR $live_iso (live $live_iso); verify map claims against the cited rules"
    test (count $doc_lag) -eq 0
    or echo "  lagging or undated (warning only): "(string join ', ' -- $doc_lag)
end

# tiers
set -l base_ok 1
set -l cats $catalogs_dir/*.json
set -l cat_mark "✓"
if test (count $cats) -eq 0
    set cat_mark "absent"
    set base_ok 0
end
echo "tier base:    rules ✓, catalogs $cat_mark — rule, rule-search, define, keyword, mtr, lookup, ref, classify, underdetermined, cite, version"

set -l idx_mark "absent"
test -r $derived_dir/cards.jsonl; and set idx_mark "✓"
set -l atomic_mark "absent"
test -r $mtgjson_dir/AtomicCards.json; and set atomic_mark "✓"
set -l sqlite_mark "absent"
test -r $mtgjson_dir/AllPrintings.sqlite; and set sqlite_mark "✓"
echo "tier cards:   AllPrintings.sqlite $sqlite_mark — card; cards.jsonl $idx_mark, AtomicCards.json $atomic_mark — corpus"
echo "tier rulings: AllPrintings.sqlite $sqlite_mark — rulings"

# keyword classification + plugin version
echo "keywords-classified: "(jq -r '.keywords | length' $skill_dir/keywords-classified.json)" keywords"
# Every CR keyword heading (701.N keyword actions, 702.N keyword abilities; the
# x.1 rules are section introductions) should have a row. Warning only.
set -l unclassified (jq -r --slurpfile kc $skill_dir/keywords-classified.json '
    ($kc[0].keywords | map(.rule)) as $have
    | to_entries[]
    | select((.key | test("^70[12][.][0-9]+$")) and (.key | test("^70[12][.]1$") | not))
    | select(.key | IN($have[]) | not)
    | "\(.key) \(.value.ruleText)"' $rules_dir/cr.json)
if test (count $unclassified) -gt 0
    set -l shown $unclassified[1..(math "min(8, "(count $unclassified)")")]
    set -l more ""
    test (count $unclassified) -gt 8; and set more ", +"(math (count $unclassified) - 8)" more"
    echo "warn: "(count $unclassified)" CR keyword heading(s) with no row in keywords-classified.json: "(string join ', ' -- $shown)$more
end
if test -n "$plugin_manifest"
    echo "plugin version: "(jq -r '.version' $plugin_manifest)
else
    echo "plugin version: unknown (plugin manifest not found)"
end

# citations
set -l cite_out ($selfdir/cite --config "$skill_dir/cite-config.json" check 2>&1)
set -l cite_status $status
echo "citations: $cite_out[-1]"

test $base_ok -eq 1 -a $cite_status -eq 0
or die "health: NOT healthy (base tier or citations failed)"
echo "health: OK (base tier + citations)"
