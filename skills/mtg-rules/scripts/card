#!/usr/bin/env fish
# card [--full-name] <name> — exact oracle text + characteristics from MTGJSON SQLite.

source (path resolve (status dirname))/lib.fish; or exit 1

test (count $argv) -ge 1; or die "usage: card [--full-name] <card name>"
set -l match_faces true
if test "$argv[1]" = --full-name
    set match_faces false
    set -e argv[1]
end
test (count $argv) -ge 1; or die "usage: card [--full-name] <card name>"
set -l name "$argv"
test -n "$name"; or die "usage: card [--full-name] <card name>"
command -q sqlite3; or die "card: sqlite3 not found"
set -l db $mtgjson_dir/AllPrintings.sqlite
test -r $db
or die "card: no card database found ($db missing). Populate it with: scripts/setup-data --runtime (plugin install) or scripts/fetch_data.fish (repo checkout)"

set -l esc (string replace -a "'" "''" -- $name)
set -l face_predicate
if $match_faces
    set face_predicate "OR faceName = '$esc' COLLATE NOCASE"
end

set -l fmt '
    "# \(.name)\(if .face and .face != .name then "  (face: \(.face), \(.layout // "?"))" else "" end)",
    "\(.manaCost // "(no mana cost)")  \(.type)",
    (.text // "(no rules text)"),
    (if .power != null then "P/T: \(.power)/\(.toughness)" else empty end),
    (if .loyalty != null then "Loyalty: \(.loyalty)" else empty end),
    (if .defense != null then "Defense: \(.defense)" else empty end),
    ""
'

set -l hits (sqlite3 -json $db "
    SELECT DISTINCT
        name,
        NULLIF(faceName, '') AS face,
        NULLIF(layout, '') AS layout,
        NULLIF(manaCost, '') AS manaCost,
        NULLIF(type, '') AS type,
        NULLIF(text, '') AS text,
        NULLIF(power, '') AS power,
        NULLIF(toughness, '') AS toughness,
        NULLIF(loyalty, '') AS loyalty,
        NULLIF(defense, '') AS defense,
        NULLIF(side, '') AS side
    FROM cards
    WHERE name = '$esc' COLLATE NOCASE
       $face_predicate
    ORDER BY CASE side WHEN 'a' THEN 0 WHEN 'b' THEN 1 ELSE 2 END, faceName;")
or die "card: query failed for '$name'"

if test -z "$hits"
    set -l near (sqlite3 $db "
        SELECT DISTINCT name
        FROM cards
        WHERE instr(lower(name), lower('$esc')) > 0
        ORDER BY name
        LIMIT 8;")
    or die "card: suggestion query failed for '$name'"
    if test (count $near) -gt 0
        die "card: no exact match for '$name'. Did you mean: "(string join ', ' $near)
    end
    die "card: no card named '$name'"
end

printf '%s\n' "$hits" | jq -r ".[] | ($fmt)"
